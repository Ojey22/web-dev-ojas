        {
          "name": "Create Post",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Post created successfully and capture ID\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"message\", \"Post created successfully\");",
                  "    pm.expect(jsonData.post).to.have.property(\"_id\");",
                  "    if (jsonData.post && jsonData.post._id) {",
                  "        pm.collectionVariables.set(\"postId\", jsonData.post._id);",
                  "        try {",
                  "            pm.environment.set(\"postId\", jsonData.post._id);",
                  "        } catch (e) {}",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
